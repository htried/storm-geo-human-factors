# --- Study arms --------------------------------------------------------------
# Comma-separated subset of: vanilla_search, injected_search, vanilla_agent, injected_agent
# Default (when unset): the two AI-overview arms only.
ENABLED_CONDITIONS=vanilla_agent,injected_agent

# Serve canned agent/chat/search output; OpenAI/SERPER keys not needed.
# Uses app/data/corpus.mock.json (npm run build:corpus:mock) if corpus.json is absent.
MOCK_EXTERNAL_APIS=1

# Total length of each AI-overview replay (research steps + report), drawn
# uniformly per session from this range in ms. Default 25000-35000.
AGENT_REPLAY_MS=25000-35000

# --- External APIs (required only when MOCK_EXTERNAL_APIS is off) -----------
OPENAI_API_KEY=
# Only required if a *_search condition is enabled.
SERPER_API_KEY=

# --- Database (server-only; never prefix with NEXT_PUBLIC_) -----------------
SUPABASE_URL=
# The secret/service_role key. Bypasses RLS: keep it in the host's encrypted env only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets (generate each with: openssl rand -hex 32) ---------------------
ASSIGN_SECRET=change-me-32-bytes
INJECT_SECRET=change-me-32-bytes
# Must be >= 32 chars in production. Also signs researcher preview URLs.
ADMIN_TOKEN=change-me
IP_HASH_SALT=change-me

# Expose /api/admin/* (config, CSV export) over HTTP. Leave off in production
# and read data through the Supabase dashboard (cornell.edu-owned account + MFA) instead.
ADMIN_API_ENABLED=0

# --- Iframe embedding (Qualtrics) ------------------------------------------
# Space-separated CSP frame-ancestors sources. Tighten to your survey's exact
# Qualtrics host once known, e.g. https://cornell.ca1.qualtrics.com
ALLOWED_FRAME_ANCESTORS=https://*.qualtrics.com

# --- Model config (ignored in mock mode) ------------------------------------
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=800
EMBEDDING_MODEL=text-embedding-3-small
